// ============================================================
// Divergence Simulations — Nextflow Configuration
// Multi-species: bacteria + dsDNA virus + ssDNA virus ×2
//                + RNA virus
// ============================================================

workDir = '/vol/projects/bguinet/aDNA_damage_simulations/Simulations/work_Simulations_divergence'

// ── Conda environments ───────────────────────────────────────
params.conda_env_ngsngs = "/vol/projects/bguinet/TOOLS/My_conda"
params.conda_env_tools  = "/vol/projects/bguinet/TOOLS/My_conda"
params.python_bin = "/home/bguinet/miniforge3/envs/My_conda/bin/python3"

// ── Tool paths ───────────────────────────────────────────────
params.ngsngs_path   = "/vol/projects/bguinet/TOOLS/My_conda/bin/ngsngs"
params.samtools_path = "/vol/projects/bguinet/TOOLS/My_conda/bin/samtools"
params.add_divergence    = "/vol/projects/bguinet/aDNA_damage_simulations/TOOLS/Generate_mutation_pob_and_add_divergence.py"
params.tools_path = "/vol/projects/bguinet/aDNA_damage_simulations/TOOLS"
params.compute_damage_metrics  = "/vol/projects/bguinet/aDNA_damage_simulations/TOOLS/compute_damage_metrics.py"
params.amber_single = "/vol/projects/bguinet/aDNA_damage_simulations/TOOLS/amber_single.py"
params.output_reference_bias = "/vol/projects/bguinet/aDNA_damage_simulations/Simulations/MultiSpecies_reference_bias"
params.output_generated_bam = "/vol/projects/bguinet/aDNA_damage_simulations/Simulations/MultiSpecies_generated_bam_links"
// Exploratory MAPQ-sweep BAMs (_mq0/_mq20/_mq25/_mq30.bam) and their counts.
params.output_mapq_sweep_bam = "/vol/projects/bguinet/aDNA_damage_simulations/Simulations/MultiSpecies_mapq_sweep_bam_links"

// ── Reference genomes directory ──────────────────────────────
// Each species must have a file named <species>.fna here.
params.ref_genomes = [
    "Herpesvirus" : "/vol/projects/bguinet/aDNA_damage_simulations/Species_MSA/Herpes_assemblies/Human_HV_1_McKrae__GCF_000859985.2.fna",
    "Yersinia"    : "/vol/projects/bguinet/aDNA_damage_simulations/Species_MSA/Yersinia_assemblies/Yersinia_pestis__GCF_000009065.1.fna",
    "Hepatitis" : "/vol/projects/bguinet/aDNA_damage_simulations/Species_MSA/Hepatitis_assemblies/HBV-A__X02763.fna"
]

params.output_damage_metrics = "/vol/projects/bguinet/aDNA_damage_simulations/Simulations/MultiSpecies_damage_metrics"

// ── Aligner settings (revised after reviewer comment, l.113-135) ──
// BWA aln: -l 16500 disables the seeding heuristic (exhaustive search).
params.bwa_aln_params   = "-l 16500 -n 0.01 -o 2"
// Bowtie2: "--sensitive" alone implies -N 0 (no mismatch allowed in the
// seed), which discards reads with a mismatch in the seed region.
// -N 1 (given after the preset, overriding it) allows one seed mismatch.
params.bowtie2_params   = "--sensitive -N 1"
// Minimum mapping quality kept after alignment (samtools view -q), applied
// identically to Bowtie2 and BWA aln. Was 1; now 25: the highest bwa aln
// threshold that still keeps uniquely placed reads at the -n mismatch
// ceiling (bwa aln assigns them MAPQ 25; 30 would discard them).
params.mapq_threshold   = 25

// Exploratory MAPQ sweep: for each (reads, reference, aligner), the task at
// subsample depth mapq_sweep_depth also writes one BAM per threshold below
// to params.output_mapq_sweep_bam. Not used downstream.
//   mapq_sweep_pattern: optional regex on the read-file name to restrict the
//                       sweep (e.g. '_25DOperc' for one damage level only).
//   Disable entirely with --mapq_sweep none
params.mapq_sweep         = [0, 20, 25, 30]
params.mapq_sweep_depth   = 1000000
params.mapq_sweep_pattern = null

params.threads_bowtie2  = 2
params.threads_bwa      = 4
params.threads_ngsngs    = 2

params.genome_list = ["Herpesvirus","Yersinia", "Hepatitis"]

// ── Per-species empirical BAM directories ────────────────────
// Maps each species name to the directory containing its
// empirical BAM files (used by ExtractReads).
// Pattern matched: <dir>/<species>*none*.bam
params.output_bam_per_species = [
    "Herpesvirus" : "/vol/projects/bguinet/aDNA_damage_simulations/Simulations/Herpesvirus_simulations",
    "Yersinia"    : "/vol/projects/bguinet/aDNA_damage_simulations/Simulations/Yersinia_simulations",
    "Hepatitis"   : "/vol/projects/bguinet/aDNA_damage_simulations/Simulations/Hepatitis_simulations"
]

// ── Output directory ─────────────────────────────────────────
params.output_ngsngs = "/vol/projects/bguinet/aDNA_damage_simulations/Simulations/MultiSpecies_simulations_divergence"

// ── Optional: external FASTQ/FASTA input ─────────────────────
// Set to a glob to inject pre-existing reads into the mapping
// and damage analysis steps. Leave as null to skip.
// Example: "/path/to/my_reads/*.fa.gz"
params.input_fastq = null

// ── MSA reference (used for identity calculations) ───────────
params.msa = [
    "Herpesvirus" : "/vol/projects/bguinet/aDNA_damage_simulations/Species_MSA/Results_Pannacota_Herpesvirus/phylogeny/concatenated.aln",
    "Yersinia"    : "/vol/projects/bguinet/aDNA_damage_simulations/Species_MSA/Results_Pannacota_Yersinia/phylogeny/concatenated.aln",
    "Hepatitis"    : "/vol/projects/bguinet/aDNA_damage_simulations/Species_MSA/Results_Pannacota_Hepatitis/phylogeny/concatenated.aln"
]

// ── Runtime ──────────────────────────────────────────────────
params.threads = 1

conda.enabled = true

// Slurm is the global/default executor. This means running Nextflow
// without any profile will still submit all processes to Slurm.
executor {
    queueSize = 200
}

// ── SLURM process configurations ─────────────────────────────
process {
    executor = 'slurm'

    withName: 'ngsNgsRun' {
        cpus           = 2
        time           = '3h'
        clusterOptions = '-J ngsNgsRun_job'
    }

    withName: 'DIVERGENCE' {
        cpus           = 1
        time           = '3h'
        clusterOptions = '-J AddDivergence_job'
    }

    withName: 'ExtractReads' {
        cpus           = 1
        time           = '1h'
        clusterOptions = '-J ExtractReads_job'
    }

    withName: 'indexGenomesBowtie2' {
        cpus           = 1
        time           = '1h'
        clusterOptions = '-J indexGenomes_Bowtie2'
    }

    withName: 'indexGenomesBWA' {
        time           = '1h'
        clusterOptions = '-J indexGenomes_BWA'
    }

    withName: 'divergenceRunBowtie2' {
        cpus           = 2
        time           = '3h'
        // single assignment: a second "clusterOptions =" line would
        // silently replace the first (the -J job name was being lost)
        clusterOptions = '-J DivergenceRun_Bowtie2 --exclude=bioinf009'
    }


    withName: 'computeReferenceBiasAmber' {
        cpus           = 1
        time           = '1h'
        clusterOptions = '-J Amber'
    }


    withName: 'divergenceRunBWA' {
        cpus           = 4
        time           = '3h'
        clusterOptions = '-J DivergenceRun_BWA --exclude=bioinf009'
    }

    withName: 'collectStats' {
        time           = '30m'
        clusterOptions = '-J collectStats'
    }
}

profiles {
    // Kept for compatibility with commands that still use: -profile slurm
    // Slurm is already the default via process.executor above.
    slurm {
        process.executor = 'slurm'
        executor {
            queueSize = 200
        }
    }
}