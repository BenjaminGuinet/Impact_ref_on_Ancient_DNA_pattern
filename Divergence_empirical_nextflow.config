/*
 * Empirical aDNA Damage Pipeline — config
 * Modeled on the working main_Hepatitis.config
 */

workDir = '/vol/projects/bguinet/aDNA_damage_simulations/Empiric/work'

params {
    outdir       = '/vol/projects/bguinet/aDNA_damage_simulations/Empiric/results'
    sample_sheet = '/vol/projects/bguinet/aDNA_damage_simulations/Empiric/samples.tsv'
    scripts_dir  = '/vol/projects/bguinet/aDNA_damage_simulations/Empiric/scripts'

    assemblies_Yersinia    = "/vol/projects/bguinet/aDNA_damage_simulations/Species_MSA/Yersinia_assemblies"
    assemblies_Hepatitis   = "/vol/projects/bguinet/aDNA_damage_simulations/Species_MSA/Hepatitis_assemblies"
    assemblies_Herpesvirus = "/vol/projects/bguinet/aDNA_damage_simulations/Species_MSA/Herpes_assemblies"
    assemblies_Salmonella  = "/vol/projects/bguinet/aDNA_damage_simulations/Species_MSA/Salmonella_assemblies"
    assemblies_Parvovirus  = "/vol/projects/bguinet/aDNA_damage_simulations/Species_MSA/Parvovirus_assemblies"
    assemblies_Variola  = "/vol/projects/bguinet/aDNA_damage_simulations/Species_MSA/Variola_assemblies"
    assemblies_Mycobacterium  = "/vol/projects/bguinet/aDNA_damage_simulations/Species_MSA/Mycobacterium_assemblies"



    subsample_depths = [100, 500, 1000, 5000, 10000]

    local_fastq_dir  = '/vol/projects/bguinet/aDNA_damage_simulations/Empiric/Fastqs'
    local_fastq_only = true

}


// ── Executor ────────────────────────────────────────────────────────────────
executor {
    queueSize    = 100
    pollInterval = '30 sec'
}

// ── Process defaults ────────────────────────────────────────────────────────
process {
    shell         = ['/bin/bash', '-l']
    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 3
    maxErrors     = '-1'

    beforeScript  = '''
        # ── conda initialisation ────────────────────────────────────────────
        # ~/.bashrc returns early in non-interactive shells on most systems, so
        # the `conda` shell function is never defined inside a SLURM job and
        # `conda activate` dies with "Run 'conda init' before 'conda activate'".
        # Source conda.sh directly instead.
        __conda_base=""
        for __c in /home/bguinet/miniforge3 "$HOME/miniforge3" "$HOME/miniconda3" "$HOME/anaconda3" /vol/projects/bguinet/TOOLS/miniforge3; do
            if [ -f "$__c/etc/profile.d/conda.sh" ]; then __conda_base="$__c"; break; fi
        done
        if [ -z "$__conda_base" ]; then
            __conda_base=$(conda info --base 2>/dev/null || echo "")
        fi
        if [ -n "$__conda_base" ] && [ -f "$__conda_base/etc/profile.d/conda.sh" ]; then
            . "$__conda_base/etc/profile.d/conda.sh"
        else
            echo "[WARN] conda.sh not found; falling back to ~/.bashrc" >&2
            . ~/.bashrc || true
        fi
        conda activate My_conda
    '''

    // ── Light processes: run locally ────────────────────────────────────────
    withName: 'MERGE_FASTQ|MAPPING_STATS|PASSTHROUGH_FULL_BAM|MERGE_METRICS' {
        executor = 'slurm'
        cpus     = 2
        memory   = '4 GB'
        time     = '12h'
        beforeScript = '''
            # ── conda initialisation ────────────────────────────────────────────
            # ~/.bashrc returns early in non-interactive shells on most systems, so
            # the `conda` shell function is never defined inside a SLURM job and
            # `conda activate` dies with "Run 'conda init' before 'conda activate'".
            # Source conda.sh directly instead.
            __conda_base=""
            for __c in /home/bguinet/miniforge3 "$HOME/miniforge3" "$HOME/miniconda3" "$HOME/anaconda3" /vol/projects/bguinet/TOOLS/miniforge3; do
                if [ -f "$__c/etc/profile.d/conda.sh" ]; then __conda_base="$__c"; break; fi
            done
            if [ -z "$__conda_base" ]; then
                __conda_base=$(conda info --base 2>/dev/null || echo "")
            fi
            if [ -n "$__conda_base" ] && [ -f "$__conda_base/etc/profile.d/conda.sh" ]; then
                . "$__conda_base/etc/profile.d/conda.sh"
            else
                echo "[WARN] conda.sh not found; falling back to ~/.bashrc" >&2
                . ~/.bashrc || true
            fi
            conda activate /vol/projects/bguinet/TOOLS/My_conda/
        '''
    }

    // ── Indexing: SLURM ────────────────────────────────────────────────────
    withName: 'BOWTIE2_INDEX' {
        executor = 'slurm'
        cpus     = 4
        memory   = '8 GB'
        time     = '2h'
    }

    withName: 'BWA_INDEX' {
        executor = 'slurm'
        cpus     = 2
        memory   = '4 GB'
        time     = '2h'
    }



    // ── Downloads: SLURM ───────────────────────────────────────────────────
    withName: 'DOWNLOAD_FASTQ' {
        executor = 'slurm'
        cpus     = 12
        memory   = '8 GB'
        time     = '48h'
    }

    // ── Trimming: SLURM ────────────────────────────────────────────────────
    withName: 'FASTP' {
        executor = 'slurm'
        cpus     = 24
        memory   = '38 GB'
        time     = '24h'
    }

    // ── Mapping: SLURM ─────────────────────────────────────────────────────


    withName: 'FILTER_FASTQ_TO_TARGET_READS' {
        executor = 'slurm'
        cpus     = 16
        memory   = '16 GB'
        time     = '12h'
    }


    withName: 'TARGET_BWA_MAP|TARGET_BOWTIE2_MAP' {
        executor = 'slurm'
        cpus     = 16
        memory   = '16 GB'
        time     = '12h'
    }
     
 
    withName: 'BOWTIE2_MAP|BWA_MAP' {
        executor = 'slurm'
        cpus     = 16
        memory   = '16 GB'
        time     = '12h'
    }

    // ── Subsampling: SLURM ─────────────────────────────────────────────────
    withName: 'SUBSAMPLE_BAM' {
        executor = 'slurm'
        cpus     = 1
        memory   = '4 GB'
        time     = '1h'
    }

    // ── Damage assessment: SLURM ───────────────────────────────────────────
    withName: 'DAMAGE_PROFILER' {
        executor = 'slurm'
        cpus     = 2
        memory   = '8 GB'
        time     = '2h'
    }

    // ── Metrics: SLURM ─────────────────────────────────────────────────────
    withName: 'COMPUTE_METRICS' {
        executor = 'slurm'
        cpus     = 1
        memory   = '4 GB'
        time     = '1h'
    }
}

// ── Reporting ───────────────────────────────────────────────────────────────
timeline {
    enabled   = true
    file      = "${params.outdir}/reports/timeline.html"
    overwrite = true
}

report {
    enabled   = true
    file      = "${params.outdir}/reports/execution_report.html"
    overwrite = true
}

trace {
    enabled   = true
    file      = "${params.outdir}/reports/trace.txt"
    overwrite = true
}

cleanup = false